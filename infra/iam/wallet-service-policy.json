{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicarEventos",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:123456789012:wallet-events"
    },
    {
      "Sid": "ConsultarEAssinarExtratos",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::wallet-statements/statements/*"
    },
    {
      "Sid": "LerCredenciaisDoBanco",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:wallet-platform/database-*"
    }
  ]
}
