{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumirFilaDeNotificacoes",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:123456789012:notifications-queue"
    },
    {
      "Sid": "LerSegredoDoJwt",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:wallet-platform/jwt-*"
    }
  ]
}
