# Copie para .env se quiser trocar os valores padrão (o .env nunca vai para o Git).
# Sem .env, o docker compose usa os padrões definidos no docker-compose.yml.

# Usuário e senha do Postgres local. Os serviços NÃO leem estes valores:
# eles buscam as credenciais no Secrets Manager (LocalStack) ao iniciar.
DB_USER=wallet
DB_PASSWORD=troque-esta-senha

# Porta do Postgres no seu computador (mude se já tiver um Postgres na 5432).
POSTGRES_HOST_PORT=5432
